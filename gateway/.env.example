# ---- gateway ----
GATEWAY_PORT=8787
GATEWAY_HOST=0.0.0.0
# Origin del frontend autorizzata per CORS
CORS_ORIGIN=http://localhost:5173

# ---- ai provider ----
# "local" = LM Studio (OpenAI-compatibile) | "openai" = API OpenAI
GATEWAY_AI_PROVIDER=local

# locale (LM Studio). Imposta GATEWAY_AI_MODEL con l'id del modello vision che hai caricato.
GATEWAY_AI_BASE_URL=http://localhost:1234/v1
GATEWAY_AI_MODEL=qwen3.8-27b-splash
GATEWAY_AI_API_KEY=lm-studio

# per il provider "openai" (il base URL è fisso, serve la chiave)
# OPENAI_API_KEY=

# ---- limiti ----
GATEWAY_AI_TIMEOUT_MS=60000
GATEWAY_AI_MAX_TOKENS=400

# Output strutturato: none | object | schema
# Qwen su LM Studio NON accetta "object" → usa "schema" oppure "none".
# "none" = nessun response_format, ci fidiamo di prompt + parse difensivo (più portatile).
GATEWAY_AI_JSON_MODE=none
